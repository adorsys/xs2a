    <changeSet author="said.ndoum@adorsys.com" id="2024-04-24-2">
        <comment>Increase size of tpp_ntfc_uri column in pis_common_payment table</comment>
        <modifyDataType tableName="pis_common_payment" columnName="tpp_ntfc_uri" newDataType="VARCHAR(255)"/>
    </changeSet>

    <changeSet author="said.ndoum@adorsys.com" id="2024-04-24-3">
        <comment>Increase size of tpp_ntfc_uri column in signing_basket_tpp_information table</comment>
        <modifyDataType tableName="signing_basket_tpp_information" columnName="tpp_ntfc_uri"
                        newDataType="VARCHAR(255)"/>
    </changeSet>

</databaseChangeLog>
